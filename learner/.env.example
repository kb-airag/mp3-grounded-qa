# Copy this file to .env, replace the placeholders, then run: source .env
export OPENAI_API_KEY="YOUR_API_KEY"
export OPENAI_BASE_URL="https://openai.vocareum.com/v1"

# Local persistent Qdrant storage (no Qdrant server required)
export QDRANT_PATH="./qdrant_storage"

# To use a Qdrant server instead, comment out QDRANT_PATH and configure:
# export QDRANT_URL="https://YOUR-CLUSTER-ID.qdrant.io:6333"
# export QDRANT_API_KEY="YOUR_QDRANT_API_KEY"
# export QDRANT_TIMEOUT="30"

# Optional abstention threshold (cosine similarity)
# export RETRIEVAL_THRESHOLD="0.30"
